# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# For local development with Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supastarter"
# ... if you use Supabase
DIRECT_URL=""

# App URLs (used for absolute URLs, sitemaps, auth callbacks, etc.)
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
NEXT_PUBLIC_SAAS_URL="http://localhost:3000"

# Docs url
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# ... for LINE (only active when `enableLine` is true in packages/auth/config.ts)
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""
# Max age in seconds of a LIFF idToken (default 300)
LIFF_ID_TOKEN_MAX_AGE_SECONDS="300"

# Mails
MAIL_FROM="noreply@example.com"
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
PRICE_ID_PRO_MONTHLY="price_asdf1234"
PRICE_ID_PRO_YEARLY="price_asdf1234"
PRICE_ID_LIFETIME="price_asdf1234"

# Analytics
# ... for Pirsch
NEXT_PUBLIC_PIRSCH_CODE=""
# ... for Plausible
NEXT_PUBLIC_PLAUSIBLE_URL=""
# ... for Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=""
# ... for Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION=""
