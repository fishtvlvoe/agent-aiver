{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "agent-aiver-admin",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"vars": { "NEXT_PUBLIC_SAAS_URL": "https://admin.aiver.me" },
	"routes": [{ "pattern": "admin.aiver.me", "custom_domain": true }],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "agent-aiver-admin"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agent-aiver-db",
			"database_id": "a6526c36-ba8c-4a6a-a96f-8fa9f29343da",
			"migrations_dir": "../../packages/database/drizzle/migrations"
		}
	],
	// 測試環境：wrangler 的 env 區塊不會繼承 services／d1_databases／assets，必須完整重寫
	"env": {
		"preview": {
			"name": "agent-aiver-admin-preview",
			"main": ".open-next/worker.js",
			"compatibility_date": "2025-09-01",
			"compatibility_flags": ["nodejs_compat"],
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "agent-aiver-admin-preview"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "agent-aiver-db",
					"database_id": "a6526c36-ba8c-4a6a-a96f-8fa9f29343da",
					"migrations_dir": "../../packages/database/drizzle/migrations"
				}
			],
			// preview 不寄真信（RESEND 為隨機值），跳過信箱驗證讓冒煙測試能直接登入
			"vars": {
				"AUTH_REQUIRE_EMAIL_VERIFICATION": "false"
			}
		}
	}
}
